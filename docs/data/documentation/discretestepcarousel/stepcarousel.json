    {
      "content" : [
        {
          "anchor" : "overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The carousel displays a scrollable sequence of views where each view represents a value in a",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "collection. The user can scroll through these views to select one value at a time, when the user",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "stops scrolling the scrollable surface snaps back to the currently selected view.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "identifier" : "animated-demo.mov",
          "type" : "video"
        },
        {
          "anchor" : "Carousel-Position",
          "level" : 3,
          "text" : "Carousel Position",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarouselPosition",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " stores the state of the selected index, the collection of selectable",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "values, and the layout information for a step carousel. The view associated with each value, a",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "inlineContent" : [
                {
                  "text" : "mark",
                  "type" : "text"
                }
              ],
              "type" : "emphasis"
            },
            {
              "text" : ", can be provided to some of the ",
              "type" : "text"
            },
            {
              "code" : "StepCarousel",
              "type" : "codeVoice"
            },
            {
              "text" : " initializers:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "@State var position: StepCarouselPosition = .init(",
            "    values: [Color.red, .orange, .yellow, .green, .teal, .blue, .indigo, .purple, .brown],",
            "    selectedIndex: 4, markLength: 40, spacing: 8",
            ")",
            "",
            "\/\/ ...",
            "",
            "Text(position.selectedValue.description)",
            "StepCarousel(position: $position) { index, value in",
            "    RoundedRectangle(cornerRadius: 8)",
            "    .fill(value.gradient)",
            "}",
            ".frame(height: 60)"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "identifier" : "step-carousel-with-colors",
              "type" : "image"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "The selected index or value can be read and set through the position instance with ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarouselPosition\/selectValue(_:immediate:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "or ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarouselPosition\/selectIndex(_:immediate:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ". Calling this functions in an animation",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "block will animate the carousel to the selected position.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "See ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarouselPosition",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " for more details.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Marks-and-Sizing",
          "level" : 3,
          "text" : "Marks and Sizing",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Each of the views that represent a carousel value is referred as a ",
              "type" : "text"
            },
            {
              "inlineContent" : [
                {
                  "text" : "mark",
                  "type" : "text"
                }
              ],
              "type" : "emphasis"
            },
            {
              "text" : ". A secondary ",
              "type" : "text"
            },
            {
              "inlineContent" : [
                {
                  "text" : "anchor",
                  "type" : "text"
                }
              ],
              "type" : "emphasis"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "view that is overlaid centered on the selected position can also be provided.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "The carousel control will expand to occupy all available space. Use a ",
              "type" : "text"
            },
            {
              "code" : "frame",
              "type" : "codeVoice"
            },
            {
              "text" : " or other layout",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "modifiers to constrain its size to the appropriate dimensions. The space available for each mark",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "is determined by the ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarouselPosition\/markLength",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " property and the height of the carousel",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "control itself. The content for each mark is constrained and centered to its available space:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "@State var position: StepCarouselPosition = .init(",
            "    values: [\"moon\", \"flame\", \"drop\", \"cloud\", \"ladybug\", \"leaf\", \"carrot\"],",
            "    selectedValue: \"cloud\",",
            "    markLength: 44, \/\/ Determines the width of each mark.",
            "    spacing: 8",
            ")",
            "",
            "\/\/ ...",
            "",
            "Text(position.selectedValue)",
            "StepCarousel(position: $position) {",
            "    \/\/ Anchor Content",
            "    Image(systemName: \"arrowtriangle.down.fill\")",
            "    .foregroundStyle(.orange)",
            "    .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .top)",
            "} markContent: { index, value in",
            "    Image(systemName: value)",
            "    .font(.title)",
            "    .frame(maxWidth: .infinity, maxHeight: .infinity)",
            "    .background(.gray.tertiary, in: RoundedRectangle(cornerRadius: 4))",
            "}",
            ".frame(height: 44) \/\/ Determines the height of the step carousel control."
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "identifier" : "step-carousel-with-images",
              "type" : "image"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Use the ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarousel\/init(position:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " or ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarousel\/init(position:anchorStyle:markStyle:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " initializers to use",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/DefaultMark",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " as the marks and anchor. Using the default ",
              "type" : "text"
            },
            {
              "code" : "markLength",
              "type" : "codeVoice"
            },
            {
              "text" : " and ",
              "type" : "text"
            },
            {
              "code" : "spacing",
              "type" : "codeVoice"
            },
            {
              "text" : ", along",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "with ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarouselDefaults\/markHeight",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " creates a carousel control with the default appearance:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "@State var position = StepCarouselPosition(",
            "    values: [\"N\", \"O\", \"P\", \"Q\", \"R\", \"S\", \"T\", \"U\", \"V\", \"W\", \"X\"],",
            "    selectedValue: \"S\"",
            ")",
            "",
            "\/\/ ...",
            "",
            "Text(position.selectedValue)",
            "StepCarousel(position: $position)",
            "    .frame(height: StepCarouselDefaults.markHeight)",
            "Text(position.selectedIndex.description)",
            "    .font(.caption)"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "identifier" : "step-carousel-with-default-mark",
              "type" : "image"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Value-identity",
          "level" : 3,
          "text" : "Value identity",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The collection of selectable values provided to the carousel are not required to contain unique",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "values since each mark is identified by its index, not the value itself. Internally the marks",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "are created using a ",
              "type" : "text"
            },
            {
              "code" : "LazyHStack",
              "type" : "codeVoice"
            },
            {
              "text" : " to create the mark views only as needed.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
      "kind" : "content"
    }
