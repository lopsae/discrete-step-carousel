    {
      "content" : [
        {
          "anchor" : "overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The carousel displays a scrollable sequence of views where each view represents a value in a",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "collection. The user can scroll through these views to select one value at a time, when the user",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "stops scrolling the scrollable surface snaps back to the currently selected view.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Each of the views that represent a carousel value is referred as a ",
              "type" : "text"
            },
            {
              "inlineContent" : [
                {
                  "text" : "mark",
                  "type" : "text"
                }
              ],
              "type" : "emphasis"
            },
            {
              "text" : ". A secondary ",
              "type" : "text"
            },
            {
              "inlineContent" : [
                {
                  "text" : "anchor",
                  "type" : "text"
                }
              ],
              "type" : "emphasis"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "view that is overlaid centered on the selected position can also be provided.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "The collection of values is not required to contain unique values. Each mark is identified by",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "its index, not the value it represents. The view for each mark is created lazily, as each view",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "needed, Both the index and value are provided to the closure that creates the mark.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Carousel-Position",
          "level" : 3,
          "text" : "Carousel Position",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarouselPosition",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " stores the state of the selected index, the collection of selectable",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "values, and the layout information for a step carousel. The selected index or value can be read",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "and set through the position instance, calling ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarouselPosition\/selectValue(_:immediate:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "or ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarouselPosition\/selectIndex(_:immediate:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " in a animation block will animate the",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "carousel to the selected position.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Marks-and-Sizing",
          "level" : 3,
          "text" : "Marks and Sizing",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The carousel control will expand to occupy all available space. Use a frame or other layout",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "modifiers to constrain its size to the appropriate dimensions. The space available for each mark",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "is determined by the ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarouselPosition\/markLength",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " property and the height of the carousel",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "control itself. Each mark is centered in its available space.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Use the ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarousel\/init(position:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " or ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarousel\/init(position:anchorStyle:markStyle:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " initializers to use the",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "default marks.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Use the ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarousel\/init(position:anchorContent:markContent:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " or ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarousel\/init(position:markContent:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " to",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "provide a closure that builds the view for each mark.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
      "kind" : "content"
    }
