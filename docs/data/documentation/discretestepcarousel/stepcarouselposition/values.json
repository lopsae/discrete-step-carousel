        {
          "inlineContent" : [
            {
              "text" : "Each value is represented by a mark view in the carousel.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "The values in this collection are not required be unique. Each mark is identified by its",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "index, not the value it represents.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "content" : [
