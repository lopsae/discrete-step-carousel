              "inlineContent" : [
                {
                  "text" : "",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
                {
                  "text" : "The collection ",
                  "type" : "text"
                },
                {
                  "inlineContent" : [
                    {
                      "text" : "must",
                      "type" : "text"
                    }
                  ],
                  "type" : "strong"
                },
                {
                  "text" : " contain at least one value. An empty collection will trigger",
                  "type" : "text"
                },
                {
                  "text" : " ",
                  "type" : "text"
                },
