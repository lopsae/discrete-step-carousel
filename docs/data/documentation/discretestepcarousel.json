          "anchor" : "Overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarousel",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " control displays a scrollable sequence of views where each view represents a",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "value in a collection. The user can scroll through these views to select one value at a time.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "identifier" : "animated-demo.mov",
          "type" : "video"
        },
        {
          "inlineContent" : [
            {
              "text" : "The control is configured through a ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/DiscreteStepCarousel\/documentation\/DiscreteStepCarousel\/StepCarouselPosition",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ", which defines the selectable values,",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "layout properties, and provides access to read and modify the current selected value.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "@State var position = StepCarouselPosition(",
            "    values: [\"N\", \"O\", \"P\", \"Q\", \"R\", \"S\", \"T\", \"U\", \"V\", \"W\", \"X\"],",
            "    selectedValue: \"S\"",
            ")",
            "",
            "\/\/ ...",
            "    ",
            "Text(position.selectedValue)",
            "StepCarousel(position: $position)",
            "    .frame(height: StepCarouselDefaults.markHeight)",
            "Text(position.selectedIndex.description)",
            "    .font(.caption)"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
